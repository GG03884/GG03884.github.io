---
import Layout from "../../layouts/Layout.astro";
---

<Layout>
  <main>
    <section class="listing">
      <div class="container">
        <p class="section-tag">
          Case Studies
        </p>

        <h2>
          Deep dives into how I designed and built each product.
        </h2>

        <div class="listing-grid">
          <a href="/case-studies/dinewise" class="listing-card">
            <span class="listing-kicker">Case Study</span>
            <h3>DineWise</h3>
            <p>
              A voice-first AI concierge that turns natural-language dining
              preferences into personalized restaurant recommendations and
              reservations.
            </p>
          </a>

          <a href="/case-studies/logpulse" class="listing-card">
            <span class="listing-kicker">Case Study</span>
            <h3>LogPulse</h3>
            <p>
              Automating the weekly status report with a zero-data-leakage
              Chrome extension.
            </p>
          </a>

          <a href="/case-studies/intelliquery" class="listing-card">
            <span class="listing-kicker">Case Study</span>
            <h3>IntelliQuery</h3>
            <p>
              An AI-powered document intelligence assistant for accurate
              knowledge retrieval.
            </p>
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>


<style>
.listing {
  padding:120px 0 120px;
}

.listing h2 {
  font-size:2.5rem;
  max-width:800px;
  margin-bottom:60px;
}

.listing-grid {
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:32px;
}

.listing-card {
  display:block;
  background:var(--bg-secondary);
  border:1px solid var(--border);
  padding:32px;
  border-radius:20px;
  transition:border-color 0.2s ease;
}

.listing-card:hover {
  border-color:var(--accent);
}

.listing-kicker {
  color:var(--accent);
  font-weight:700;
  font-size:0.9rem;
  display:block;
  margin-bottom:14px;
}

.listing-card h3 {
  font-size:1.4rem;
  margin-bottom:12px;
}

.listing-card p {
  color:var(--text-secondary);
}

@media(max-width:800px){

  .listing {
    padding:100px 0 80px;
  }

  .listing-grid {
    grid-template-columns:1fr;
  }

}

@media(max-width:480px){

  .listing {
    padding:90px 0 60px;
  }

}
</style>
