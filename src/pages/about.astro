---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <main>
    <section class="about">

      <div class="container">

        <p class="section-tag">
          About Me
        </p>

        <h2>
          Building at the intersection of AI, technology, and people.
        </h2>


        <div class="about-timeline">

          <div class="about-row">
            <span class="about-index">01</span>
            <div class="about-content">
              <h3>Who I am</h3>
              <p>
                I am a software engineer turned AI product enthusiast,
                passionate about transforming emerging technologies into
                products that create meaningful user impact.
              </p>
            </div>
          </div>

          <div class="about-row">
            <span class="about-index">02</span>
            <div class="about-content">
              <h3>My journey</h3>
              <p>
                I hold a B.Tech. in Computer Science and Engineering
                (Artificial Intelligence) from NSUT Delhi and have experience
                building developer tools at IBM, working at the intersection
                of complex technology and real-world users. Currently
                pursuing the PGPYL programme at ISB, I am exploring how
                technology can be translated into meaningful products and
                user experiences.
              </p>
            </div>
          </div>

          <div class="about-row">
            <span class="about-index">03</span>
            <div class="about-content">
              <h3>What excites me</h3>
              <p>
                I enjoy understanding user problems, exploring AI capabilities,
                and designing solutions that balance technical feasibility,
                usability, and business impact.
              </p>
            </div>
          </div>

          <div class="about-row">
            <span class="about-index">04</span>
            <div class="about-content">
              <h3>What I'm looking for</h3>
              <p>
                I am exploring opportunities where I can leverage my technical
                background, strategic thinking, and customer-focused approach
                to contribute to meaningful products and business outcomes.
              </p>
            </div>
          </div>

        </div>

      </div>

    </section>
  </main>
</Layout>


<style>
.about {
  padding:120px 0 120px;
}

.about h2 {
  font-size:2.5rem;
  max-width:800px;
  margin-bottom:60px;
}

.about-timeline {
  display:flex;
  flex-direction:column;
}

.about-row {
  display:grid;
  grid-template-columns:120px 1fr;
  gap:32px;
  align-items:start;
  padding:36px 0;
  border-top:1px solid var(--border);
  transition:padding-left 0.25s ease;
}

.about-row:last-child {
  border-bottom:1px solid var(--border);
}

.about-row:hover {
  padding-left:16px;
}

.about-index {
  font-size:2.75rem;
  font-weight:800;
  letter-spacing:-0.03em;
  color:var(--border);
  line-height:1;
  transition:color 0.25s ease;
}

.about-row:hover .about-index {
  color:var(--accent);
}

.about-content h3 {
  font-size:1.3rem;
  margin-bottom:12px;
}

.about-content p {
  color:var(--text-secondary);
  max-width:640px;
  font-size:1.05rem;
}

@media(max-width:800px){

  .about {
    padding:100px 0 80px;
  }

  .about-row {
    grid-template-columns:1fr;
    gap:12px;
  }

  .about-index {
    font-size:2rem;
  }

}

@media(max-width:480px){

  .about {
    padding:90px 0 60px;
  }

}
</style>
