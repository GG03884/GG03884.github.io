---
import Layout from "../layouts/Layout.astro";
import dineWiseDemo from "../videos/GAYATRI GUPTA DEMO (2).mp4";
import logPulseDemo from "../videos/Recording 2026-07-26 134350.mp4";
import videoProjectA from "../videos/Video Project A.mp4";
---

<Layout>
  <main>
    <section class="projects">
      <div class="container">
        <p class="section-tag">
          Projects
        </p>

        <div class="project-showcase">
          <div class="project-copy">
            <p class="project-kicker">
              Featured Build
            </p>

            <h2>
              DineWise
            </h2>

            <p>
              A voice-first AI concierge that transforms natural-language dining
              preferences into personalized restaurant recommendations and
              real-time table reservations through Swiggy Dineout MCP.
            </p>

            <div class="project-metrics">
              <span>Voice-first</span>
              <span>Real-time availability</span>
              <span>Swiggy Dineout MCP</span>
            </div>

            <div class="project-actions">
              <a href="/case-studies/dinewise" class="primary">
                Read Case Study
              </a>
              <a href="/prd/dinewise" class="secondary">
                View PRD
              </a>
            </div>
          </div>

          <div class="project-demo">
            <video controls preload="metadata" playsinline>
              <source src={dineWiseDemo} type="video/mp4" />
              Your browser does not support the video tag.
            </video>
          </div>
        </div>

        <div class="project-showcase">
          <div class="project-copy">
            <p class="project-kicker">
              Featured Build
            </p>

            <h2>
              LogPulse
            </h2>

            <p>
              A privacy-first Chrome extension that generates weekly engineering
              status reports from GitHub, Jira, and Google Calendar activity using
              a local LLM.
            </p>

            <div class="project-metrics">
              <span>~5 sec generation</span>
              <span>$0 API cost</span>
              <span>Zero remote data transmission</span>
            </div>

            <div class="project-actions">
              <a href="/case-studies/logpulse" class="primary">
                Read Case Study
              </a>
              <a href="/prd/logpulse" class="secondary">
                View PRD
              </a>
            </div>
          </div>

          <div class="project-demo">
            <video controls preload="metadata" playsinline>
              <source src={logPulseDemo} type="video/mp4" />
              Your browser does not support the video tag.
            </video>
          </div>
        </div>

        <div class="project-showcase">
          <div class="project-copy">
            <p class="project-kicker">
              Featured Build
            </p>

            <h2>
              IntelliQuery
            </h2>

            <p>
              An AI-powered RAG experience that turns uploaded PDFs into an
              interactive knowledge assistant with grounded answers, citations,
              and fast semantic search.
            </p>

            <div class="project-metrics">
              <span>&lt;5 sec indexing</span>
              <span>3–5 sec responses</span>
              <span>100% grounded answers</span>
            </div>

            <div class="project-actions">
              <a href="/case-studies/intelliquery" class="primary">
                Read Case Study
              </a>
              <a href="/prd/intelliquery" class="secondary">
                View PRD
              </a>
            </div>
          </div>

          <div class="project-demo">
            <video controls preload="metadata" playsinline>
              <source src={videoProjectA} type="video/mp4" />
              Your browser does not support the video tag.
            </video>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>


<style>
.projects {
  padding:120px 0 80px;
}

.project-showcase {
  display:grid;
  grid-template-columns:minmax(280px, 0.8fr) minmax(0, 1.2fr);
  gap:56px;
  align-items:center;
}

.project-showcase + .project-showcase {
  margin-top:64px;
  padding-top:24px;
  border-top:1px solid var(--border);
}

.project-kicker {
  color:var(--accent);
  font-weight:700;
  margin-bottom:14px;
}

.project-copy h2 {
  margin-bottom:18px;
}

.project-copy > p:not(.project-kicker) {
  color:var(--text-secondary);
  font-size:1.05rem;
  max-width:560px;
  margin-bottom:28px;
}

.project-metrics {
  display:flex;
  flex-wrap:wrap;
  gap:10px;
  margin-bottom:32px;
}

.project-metrics span {
  border:1px solid var(--border);
  color:var(--text-secondary);
  padding:8px 12px;
  font-size:0.9rem;
}

.project-actions {
  display:flex;
  flex-wrap:wrap;
  gap:14px;
}

.project-actions .primary,
.project-actions .secondary {
  padding: 12px 24px;
  border-radius: 999px;
  font-weight: 600;
}

.project-actions .primary {
  background: var(--accent);
  color: white;
}

.project-actions .secondary {
  border: 1px solid var(--border);
}

.project-demo {
  border:1px solid var(--border);
  background:var(--bg-secondary);
  padding:12px;
}

.project-demo video {
  display:block;
  width:100%;
  max-height:720px;
  object-fit:contain;
  background:#000000;
}

@media(max-width:800px){

  .projects {
    padding:100px 0 60px;
  }

  .project-showcase {
    grid-template-columns:1fr;
  }

}

@media(max-width:480px){

  .projects {
    padding:90px 0 60px;
  }

}
</style>
