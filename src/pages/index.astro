---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <main>
    <section class="hero">
      <div class="container">

        <p class="affiliations">
          ISB • IBM • Amazon • NSUT
        </p>

        <h1>
          Hi, I'm Gayatri Gupta.
        </h1>

        <h2>
          I build AI products that solve real customer problems.
        </h2>

        <p class="description">
          Former Software Developer at IBM, holding a B.Tech. in Computer
          Science and Engineering (Artificial Intelligence) from NSUT Delhi,
          with experience building developer tools and AI-powered
          applications. Currently pursuing the PGPYL programme at ISB,
          exploring the intersection of technology, users, and product
          strategy.
        </p>

        <div class="buttons">

          <a href="/projects" class="primary">
            View My Work
          </a>

          <a href="/resume.pdf" class="secondary">
            Resume
          </a>

          <a href="https://www.linkedin.com/in/gayatri-gupta-tech/" target="_blank" class="secondary">
            LinkedIn
          </a>

          <a href="https://github.com/GG03884" target="_blank" class="secondary">
            GitHub
          </a>

          <a href="mailto:gayatri03884@gmail.com" class="secondary">
            Email
          </a>

        </div>

      </div>
    </section>
  </main>
</Layout>


<style>
.hero {
  min-height: 100vh;
  padding-top: 100px;
  padding-bottom: 40px;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

@media(max-height:700px){

  .hero {
    min-height: auto;
    padding-top: 120px;
  }

}

.affiliations {
  color: var(--accent);
  font-size: 0.95rem;
  margin-bottom: 20px;
}

h1 {
  font-size: 4rem;
  font-weight: 800;
  letter-spacing: -0.05em;
  margin-bottom: 20px;
}

.hero h2 {
  font-size: 2rem;
  max-width: 700px;
}

.description {
  color: var(--text-secondary);
  max-width: 650px;
  font-size: 1.1rem;
  margin-bottom: 40px;
}

.buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
}

.primary,
.secondary {
  padding: 12px 24px;
  border-radius: 999px;
  font-weight: 600;
}

.primary {
  background: var(--accent);
  color: white;
}

.secondary {
  border: 1px solid var(--border);
}


@media(max-width:768px){

  h1 {
    font-size: 3rem;
  }

  .hero h2 {
    font-size:1.5rem;
  }

}
</style>
