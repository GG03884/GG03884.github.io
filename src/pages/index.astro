  max-width:800px;
  margin-bottom:60px;
}


.about-grid {

  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:40px;

}


.about-grid div {

  background:var(--bg-secondary);
  border:1px solid var(--border);
  padding:30px;
  border-radius:20px;

}


.about-grid h3 {

  margin-bottom:15px;

}


.about-grid p {

  color:var(--text-secondary);

}

.experience {
  padding: 120px 0 80px;
}

.experience-list {
  display:grid;
  gap:24px;
}

.experience-card {
  background:var(--bg-secondary);
  border:1px solid var(--border);
  padding:30px;
  border-radius:20px;
}

.experience-meta {
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:16px;
  margin-bottom:12px;
}

.experience-meta span {
  color:var(--accent);
  font-size:0.95rem;
}

.projects {
  padding:120px 0 80px;
}

.project-showcase {
  display:grid;
  grid-template-columns:minmax(280px, 0.8fr) minmax(0, 1.2fr);
  gap:56px;
  align-items:center;
}

.project-showcase + .project-showcase {
  margin-top:64px;
  padding-top:24px;
  border-top:1px solid var(--border);
}

.project-kicker {
  color:var(--accent);
  font-weight:700;
  margin-bottom:14px;
}

.project-copy h2 {
  margin-bottom:18px;
}

.project-copy > p:not(.project-kicker) {
  color:var(--text-secondary);
  font-size:1.05rem;
  max-width:560px;
